# AI Compressor Backend Environment Variables

# Optional: Google Gemini API Key for AI Content-Aware recommendations
# If empty, the system automatically uses deterministic local AI-assisted analysis
GEMINI_API_KEY=""

# Maximum upload file size in Megabytes
MAX_FILE_SIZE_MB=100

# Server settings
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Optional path to FFmpeg binary (leave empty to auto-detect from PATH or standard install dirs)
FFMPEG_PATH=""
