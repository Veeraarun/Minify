# MINIFY Backend Environment Configuration

# Optional: Google Gemini API Key for intelligent content-aware analysis
# If empty, MINIFY automatically falls back to deterministic local AI-assisted analysis
GEMINI_API_KEY=""

# Maximum upload file size in Megabytes (per file)
MAX_FILE_SIZE_MB=100

# Maximum number of files permitted in a single batch
MAX_BATCH_FILES=25

# Temporary file retention in seconds before automated purging (default: 3600 = 1 hour)
FILE_RETENTION_SECONDS=3600

# Server settings
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins (comma-separated, without trailing slashes)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Optional path to FFmpeg binary (leave empty to auto-detect from PATH or standard install dirs)
FFMPEG_PATH=""
